generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String

  products          Product[]
  productCategories ProductCategory[]
  ingredients       Ingredient[]
  payments          Payment[]
  expenses          Expense[]

  @@map("users")
}

model Product {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  name        String
  description String?
  imagePath   String?
  price       Float
  categoryId  String?               @map("product_category_id") @db.Uuid
  ingredients IngredientsProducts[]

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("products")
}

model IngredientsProducts {
  ingredientId String @map("ingredient_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, productId])
  @@map("ingredients_products")
}

model ProductCategory {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  name     String
  icon     String
  products Product[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name]) // Adicionando a restrição de unicidade composta
  @@map("product_category")
}

model Ingredient {
  id       String                @id @default(uuid()) @db.Uuid
  userId   String                @map("user_id") @db.Uuid
  name     String
  icon     String
  products IngredientsProducts[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ingredients")
}

model Payment {
  id       String      @id @default(uuid()) @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  clientId String      @map("client_id") @db.Uuid
  type     PaymentType
  date     DateTime    @default(now())
  value    Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

model Expense {
  id     String       @id @default(uuid()) @db.Uuid
  userId String       @map("user_id") @db.Uuid
  type   ExpenseType? @default(OTHERS)
  date   DateTime     @default(now())
  value  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

enum ExpenseType {
  TAXES
  DELIVERY
  EQUIPMENTS
  EMPLOYEES
  UTENSILS
  MEATS
  GARRISONS
  OTHERS
}
